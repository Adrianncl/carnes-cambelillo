<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="https://carnes-cambelillo.example/index" xmlns="https://carnes-cambelillo.example/index" elementFormDefault="qualified">

	<xs:element name="pagina">
		  <xs:complexType>
			    <xs:sequence>

              <xs:element name="cabecera">
					        <xs:complexType>
						          <xs:sequence>
							           <xs:element name="titulo" type="xs:string"/>
							           <xs:element name="subtitulo" type="xs:string"/>
							            <xs:element name="logo" type="xs:string"/>
						          </xs:sequence>
					        </xs:complexType>
				     </xs:element>

              <xs:element name="portada">
					        <xs:complexType>
                      <xs:sequence>
							            <xs:element name="imagen" type="xs:string"/>
							            <xs:element name="mensaje" type="xs:string"/>
                      </xs:sequence>
					        </xs:complexType>
				      </xs:element>

				      <xs:element name="ofertas">
					        <xs:complexType>
						          <xs:sequence>
                          <xs:element name="oferta" maxOccurs="unbounded">
								              <xs:complexType>
									               <xs:sequence>
										                  <xs:element name="nombre" type="xs:string"/>
										                  <xs:element name="precio" type="xs:decimal"/>
								      	          </xs:sequence>
                             </xs:complexType>
                        </xs:element>

						        </xs:sequence>
					    </xs:complexType>
          </xs:element>

				  <xs:element name="marcas">
					    <xs:complexType>
						      <xs:sequence>
							        <xs:element name="marca" type="xs:string" maxOccurs="unbounded"/>
						      </xs:sequence>
					    </xs:complexType>
				  </xs:element>

			    </xs:sequence>
		  </xs:complexType>
  </xs:element>

</xs:schema>